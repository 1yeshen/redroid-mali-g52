# ============================================================
# Dockerfile.panfrost
#
# Minimal Docker overlay for Panfrost GPU acceleration on
# RK3568 devices (EasePi R1, Radxa ROCK3A/B, etc.).
#
# Why this is minimal:
#   The base image (redroid/redroid:14.0.0_64only-latest) ALREADY:
#   1. Ships Mesa with Panfrost Gallium & Vulkan drivers
#      (panfrost_dri.so, vulkan.panfrost.so, gralloc.gbm.so)
#   2. Has vendor_redroid's gpu_config.sh which auto-detects
#      Panfrost via /sys/kernel/debug/dri/*/name
#   3. Has NO Mali init scripts to override (unlike older images)
#
# So this overlay only adds metadata and convenience defaults.
# The real magic happens at runtime when gpu_config.sh sees
# the "panfrost" driver and sets all GPU properties correctly.
# ============================================================
ARG REDROID_BASE=redroid/redroid:14.0.0_64only-latest
FROM ${REDROID_BASE}

# Convenience environment variables (can be overridden at runtime)
# These are just defaults; gpu_config.sh will auto-detect anyway
ENV TARGET_BOARD_PLATFORM_GPU=panfrost

# NOTE: No RUN instructions allowed! The redroid base image is an Android
# system image without a standard Linux shell. Only LABEL, ENV, and other
# OCI metadata instructions work.

LABEL description="redroid with Panfrost GPU acceleration for RK3568 (Mali-G52)"
LABEL gpu.driver="panfrost"
LABEL gpu.mode="host"
LABEL gpu.auto_detect="vendor_redroid/gpu_config.sh auto-detects Panfrost via debugfs"
