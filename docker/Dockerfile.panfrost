# ============================================================
# Dockerfile.panfrost
#
# Build a custom redroid Docker image with Panfrost GPU
# support for RK3568 devices (EasePi R1, Radxa ROCK3A/B, etc.)
#
# Strategy: The Mali GPU init scripts in the base redroid
# image unconditionally set Mali GPU properties on boot,
# overriding gpu_mode=host. This overlay:
#   1. Overrides Mali .rc files with empty (no-op) files
#   2. Adds a Panfrost-specific .rc that sets Mesa/GBM props
#
# The Panfrost Mesa userspace libraries (panfrost_dri.so,
# vulkan.panfrost.so, gralloc.gbm.so, libEGL_mesa.so) are
# ALREADY included in the standard redroid image.
# ============================================================
ARG REDROID_BASE=redroid/redroid:14.0.0-arch-fix
FROM ${REDROID_BASE}

# Override Mali GPU init scripts with empty/no-op files
# This prevents them from setting:
#   ro.hardware.egl=mali
#   ro.hardware.gralloc=bifrost
#   ro.hardware.vulkan=mali
#   ro.boot.gpu_mode=mali
COPY docker/panfrost-config/empty.rc /vendor/etc/init/init.mali_gpu.rc
COPY docker/panfrost-config/empty.rc /vendor/etc/init/init.rockchip.gpu.rc
COPY docker/panfrost-config/empty.rc /vendor/etc/init/gpu_config_mali.sh

# Add Panfrost GPU init script (sets Mesa/GBM/panfrost properties)
COPY docker/panfrost-config/init.panfrost_gpu.rc /vendor/etc/init/init.panfrost_gpu.rc

LABEL description="redroid with Panfrost GPU acceleration for RK3568 (Mali-G52)"
LABEL gpu.driver="panfrost"
LABEL gpu.mode="host"
